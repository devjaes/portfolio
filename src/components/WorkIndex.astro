---
import { getCollection } from "astro:content";
import { getTranslations, type Locale } from "../i18n";
import type { WorkCard, WorkStatus } from "../i18n/types";
import { filterWorkByLocale, getWorkUrl } from "../lib/work-urls";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const t = getTranslations(locale);

const projects = filterWorkByLocale(await getCollection("work"), locale)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const cards: WorkCard[] = [...t.work.building, ...t.work.flagship, ...t.work.more, ...t.work.earlier];
const cardFor = (id: string) => {
  const slug = id.replace(/\.es\.md$/, "").replace(/\.md$/, "");
  return cards.find((c) => c.slug === slug);
};

const GLYPH: Record<WorkStatus, string> = { ship: "▲", build: "◉", paused: "■", down: "▼" };
const CLS: Record<WorkStatus, string> = { ship: "up", build: "am", paused: "fl", down: "dn" };
---

<section class="section">
  <div class="wrap">
    <div class="sec-head">
      <div class="left">
        <span class="sec-idx">~/</span>
        <h2 class="sec-title">{t.workPage.title}</h2>
      </div>
      <span class="sec-sub">{t.workPage.subtitle}</span>
    </div>

    <div class="mids">
      {projects.map((project) => {
        const card = cardFor(project.id);
        const status = (card?.status ?? "ship") as WorkStatus;
        return (
          <a class="mid reveal" href={getWorkUrl(project, locale)}>
            {project.data.img && !project.data.img.includes("/stock-") && <div class="mid-thumb"><img src={project.data.img} alt={project.data.img_alt ?? project.data.title} loading="lazy" /></div>}
            <div class="mid-top">
              <div class="mid-id">
                {card?.symbol && <span class="mid-sym">{card.symbol}</span>}
                <h3>{project.data.title}</h3>
              </div>
              <span class:list={["status-pill", "sm", CLS[status]]}><span class="gly">{GLYPH[status]}</span>{t.work.statusLabels[status]}</span>
            </div>
            <p class="mid-desc">{project.data.description}</p>
            <div class="mid-tags">
              {project.data.tags.slice(0, 4).map((tag) => <span class="mini-tag">{tag}</span>)}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
