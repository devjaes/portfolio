---
import { getTranslations, type Locale } from "../i18n";
import BrandIcon from "./BrandIcon.astro";
import { socialLinks } from "../config/social";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const t = getTranslations(locale);
const c = t.heroCard;

const email = "hello@devjaes.dev";
const homePath = locale === "es" ? "/es/" : "/";
const [symHead, symTail] = c.barSymbol.split(":");

// Subheadline carries **bold** markers — translation strings are trusted/static.
const renderLead = (s: string) =>
  s.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
---

<header class="hero section" id="top">
  <div class="wrap hero-grid">
    <aside class="idcard reveal in">
      <div class="bar">
        <span class="l mono-sym">{symHead}<span class="tk-sym">:{symTail}</span></span>
        <span class="q-tag"><span class="dot dot-up pulse"></span> {c.barStatus}</span>
      </div>
      <div class="photo">
        <img src="/assets/portrait.jpg" alt={t.hero.portraitAlt} width="1024" height="765" fetchpriority="high" decoding="async" />
        <span class="photo-tag">{c.photoTag}</span>
      </div>
      <div class="idbody">
        <div class="id-head">
          <div class="q-id">
            <div class="q-name">Jair Mera</div>
            <div class="q-meta">{c.metaLabel}</div>
          </div>
          <div class="id-status">
            <div class="sl">{c.statusTitle}</div>
            <div class="sline up"><span class="gly">▲</span> {c.statusLine1}</div>
            <div class="sline am"><span class="gly">◉</span> {c.statusLine2}</div>
          </div>
        </div>
        <div class="id-stats">
          <div class="st"><div class="sl">{c.stackLabel}</div><div class="sv">{c.stackValue}</div></div>
          <div class="st"><div class="sl">{c.certLabel}</div><div class="sv">{c.certValue}</div></div>
          <div class="st"><div class="sl">{c.zoneLabel}</div><div class="sv">{c.zoneValue}</div></div>
        </div>
      </div>
    </aside>

    <div class="hero-copy">
      <div class="hero-badges">
        <a class="chip chip-amber" href={t.hero.awsCertVerifyUrl} target="_blank" rel="noopener noreferrer">{t.hero.awsChip}</a>
        <span class="chip">{t.hero.locationPill}</span>
      </div>

      <div class="hero-title">
        <h1 set:html={t.hero.headline.replace(/\n/g, "<br>")} />
        <p class="hero-tagline">{t.hero.tagline}</p>
      </div>

      <p class="hero-sub" set:html={renderLead(t.hero.subLead)} />

      <div class="hero-actions">
        <a class="btn btn-primary" href={`${homePath}#experience`}>
          {t.hero.viewExperienceCta}
          <svg class="ico" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn-ghost" href={`${homePath}#work`}>
          {t.hero.primaryCta}
          <svg class="ico" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <div class="hero-social">
          {socialLinks.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}><BrandIcon name={s.icon} class="w-4 h-4" /></a>
          ))}
          <a href={`mailto:${email}`} aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M4 7l8 6 8-6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>
