---
import { getTranslations, type Locale } from "../i18n";
interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const t = getTranslations(locale);
---

<section class="section" id="experience" style="padding-top:8px">
  <div class="wrap">
    <div class="sec-head">
      <div class="left">
        <span class="sec-idx">01 /</span>
        <h2 class="sec-title">{t.experience.title}</h2>
      </div>
      <span class="sec-sub">{t.experience.subtitle}</span>
    </div>
    <div class="xp">
      {t.experience.entries.map((x) => (
        <div class="xp-row reveal">
          <div class="xp-when">
            <span class="xp-date">{x.date}</span>
            <span class="xp-co">{x.company}</span>
          </div>
          <div class="xp-body">
            <h3>
              {x.title}
              {x.current && (
                <span class="chip chip-up"><span class="dot dot-up pulse"></span>{t.experience.currentLabel}</span>
              )}
            </h3>
            <div class="xp-badges">
              {x.badges.map((b) => <span class="mini-tag">{b}</span>)}
            </div>
            <ul class="xp-points">
              {x.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
