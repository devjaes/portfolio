---
import { getTranslations, type Locale } from "../i18n";
import LangToggle from "./LangToggle.astro";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const t = getTranslations(locale);

const homePath = locale === "es" ? "/es/" : "/";
const aboutPath = locale === "es" ? "/es/about/" : "/about/";
const email = "hello@devjaes.dev";

const links = [
  { label: t.nav.building, href: `${homePath}#building` },
  { label: t.nav.projects, href: `${homePath}#work` },
  { label: t.nav.experience, href: `${homePath}#experience` },
  { label: t.nav.about, href: aboutPath },
  { label: t.nav.contact, href: `${homePath}#contact` },
];
---

<nav class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={homePath} aria-label="Jair Mera — home"><span class="sq"></span> JAIR&nbsp;MERA</a>

    <div class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>

    <div class="nav-right">
      <LangToggle locale={locale} />
      <span class="nav-status"><span class="dot dot-up pulse"></span> {t.nav.statusOpen}</span>
      <button class="nav-kbd hidden md:inline-flex" id="cmdk-open" aria-label={t.commandPalette.openLabel} title={t.nav.commandLabel}>⌘K</button>
      <span class="nav-clock hidden md:inline" id="clock">—</span>
      <a class="nav-cta hidden md:inline-flex" href={`mailto:${email}`}>{email}</a>

      <button id="mobile-menu-btn" class="md:hidden p-2 text-tx-2 hover:text-tx-0 transition-colors" aria-label={t.nav.menuLabel} aria-expanded="false">
        <svg class="w-6 h-6 menu-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg class="w-6 h-6 close-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-line">
    <div class="wrap py-4 space-y-1">
      {links.map((l) => (
        <a href={l.href} class="block px-3 py-3 rounded-xs font-mono text-sm text-tx-1 hover:text-tx-0 hover:bg-bg-2 transition-colors">{l.label}</a>
      ))}
      <a href={`mailto:${email}`} class="block px-3 py-3 rounded-xs font-mono text-sm text-tx-1 hover:text-tx-0 hover:bg-bg-2 transition-colors">{email}</a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", (!open).toString());
    menu?.classList.toggle("hidden");
    btn.querySelector(".menu-icon")?.classList.toggle("hidden");
    btn.querySelector(".close-icon")?.classList.toggle("hidden");
  });

  // EST / UTC−5 clock
  const node = document.getElementById("clock");
  if (node) {
    const tick = () => {
      const now = new Date();
      const utc = now.getTime() + now.getTimezoneOffset() * 60000;
      const est = new Date(utc - 5 * 3600000);
      const p = (n: number) => String(n).padStart(2, "0");
      node.textContent = `${p(est.getHours())}:${p(est.getMinutes())}:${p(est.getSeconds())} EST`;
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
