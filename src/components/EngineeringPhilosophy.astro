---
import { getTranslations, type Locale } from "../i18n";
interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const t = getTranslations(locale);

const ICONS: Record<string, string> = {
  layers: "M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5M3 17l9 5 9-5",
  shield: "M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3z",
  rocket: "M5 19l3-3m-3 3l-2 2m5-5c2-6 6-9 12-9 0 6-3 10-9 12l-3-3zm9-7a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z",
};
---

<section class="section" style="padding-top:0" aria-label={t.philosophy.title}>
  <div class="wrap">
    <h2 class="sr-only">{t.philosophy.title}</h2>
    <div class="principles reveal">
      {t.philosophy.cards.map((card) => (
        <div class="principle">
          <div class="h">
            <span class="ic">
              <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={ICONS[card.icon]} /></svg>
            </span>
            <h3>{card.title}</h3>
            {card.highlightLabel && <span class="tag" style="margin-left:auto">{card.highlightLabel}</span>}
          </div>
          <p>{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
