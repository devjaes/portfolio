---
import { getTranslations, type Locale } from "../i18n";
import type { WorkCard } from "../i18n/types";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const t = getTranslations(locale);
const base = locale === "es" ? "/es" : "";

const hrefFor = (p: WorkCard): string | undefined => {
  if (p.link) return p.link;
  if (p.slug) return `${base}/work/${p.slug}/`;
  return undefined;
};
const isExternal = (p: WorkCard): boolean => Boolean(p.link);
---

<section id="projects" class="section-spacing">
  <div class="container-custom space-y-20">
    {/* Currently Building */}
    {
      t.work.building.length > 0 && (
        <div>
          <div class="mb-8">
            <h2 class="text-2xl font-bold sm:text-3xl mb-3">
              {t.work.currentlyBuildingTitle}
            </h2>
            <p class="text-text-secondary max-w-2xl">
              {t.work.currentlyBuildingSubtitle}
            </p>
          </div>
          <div class="grid grid-cols-1 gap-5">
            {t.work.building.map((p) => (
              <article class="relative rounded-xl border border-accent-cyan/30 bg-surface/40 p-6 md:p-8">
                <div class="mb-3 flex flex-wrap items-center gap-3">
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-accent-cyan/40 bg-accent-cyan/10 px-2.5 py-1 text-xs font-medium text-accent-cyan">
                    <span class="h-1.5 w-1.5 rounded-full bg-accent-cyan" />
                    {t.work.inProgressLabel}
                  </span>
                  {p.context && (
                    <span class="text-xs font-medium uppercase tracking-wider text-text-muted">
                      {p.context}
                    </span>
                  )}
                </div>
                <h3 class="mb-3 text-2xl font-semibold text-text-primary">
                  {p.title}
                </h3>
                <p class="mb-5 max-w-3xl text-text-secondary">{p.description}</p>
                <div class="flex flex-wrap gap-2">
                  {p.tech.map((tech) => (
                    <span class="rounded-full border border-surface-border bg-surface-light px-3 py-1 text-xs font-medium text-text-secondary">
                      {tech}
                    </span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      )
    }

    {/* Selected Work (flagship) */}
    <div>
      <div class="mb-10">
        <h2 class="text-3xl sm:text-4xl font-bold mb-3">{t.work.flagshipTitle}</h2>
        <p class="text-text-secondary max-w-2xl">{t.work.flagshipSubtitle}</p>
      </div>
      <div class="space-y-6">
        {
          t.work.flagship.map((p) => {
            const href = hrefFor(p);
            return (
              <article class="group relative grid md:grid-cols-[1.1fr_1fr] rounded-xl border border-surface-border bg-surface/40 overflow-hidden transition-colors hover:border-accent-cyan/40">
                {href && (
                  <a
                    href={href}
                    target={isExternal(p) ? "_blank" : undefined}
                    rel={isExternal(p) ? "noopener noreferrer" : undefined}
                    class="absolute inset-0 z-10"
                    aria-label={p.title}
                  />
                )}
                <div class="relative h-56 md:h-full overflow-hidden">
                  <img
                    src={p.image}
                    alt={p.imageAlt || p.title}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-surface via-surface/40 to-transparent" />
                </div>
                <div class="flex flex-col p-6 md:p-8">
                  {p.context && (
                    <p class="mb-3 text-xs font-medium uppercase tracking-wider text-text-muted">
                      {p.context}
                    </p>
                  )}
                  <h3 class="mb-3 text-2xl font-semibold text-text-primary transition-colors group-hover:text-accent-cyan">
                    {p.title}
                  </h3>
                  <p class="mb-5 text-text-secondary">{p.description}</p>
                  <div class="mb-6 flex flex-wrap gap-2">
                    {p.tech.map((tech) => (
                      <span class="rounded-full border border-surface-border bg-surface-light px-3 py-1 text-xs font-medium text-text-secondary">
                        {tech}
                      </span>
                    ))}
                  </div>
                  {p.stats && p.stats.length > 0 && (
                    <div class="mt-auto flex gap-8 border-t border-surface-border pt-4">
                      {p.stats.map((s) => (
                        <div>
                          <div class="font-mono text-xl font-bold text-accent-cyan">
                            {s.value}
                          </div>
                          <div class="text-xs text-text-muted">{s.label}</div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>

    {/* More Work */}
    <div>
      <div class="mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold mb-3">{t.work.moreTitle}</h2>
        <p class="text-text-secondary max-w-2xl">{t.work.moreSubtitle}</p>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {
          t.work.more.map((p) => {
            const href = hrefFor(p);
            return (
              <article class="group relative rounded-xl border border-surface-border bg-surface/30 p-6 transition-colors hover:border-accent-cyan/40 hover:bg-surface">
                {href && (
                  <a
                    href={href}
                    target={isExternal(p) ? "_blank" : undefined}
                    rel={isExternal(p) ? "noopener noreferrer" : undefined}
                    class="absolute inset-0 z-10"
                    aria-label={p.title}
                  />
                )}
                {p.context && (
                  <p class="mb-2 text-xs font-medium uppercase tracking-wider text-text-muted">
                    {p.context}
                  </p>
                )}
                <h3 class="mb-2 text-xl font-semibold text-text-primary transition-colors group-hover:text-accent-cyan">
                  {p.title}
                </h3>
                <p class="mb-4 text-sm text-text-secondary">{p.description}</p>
                {p.highlight && (
                  <p class="mb-4 text-sm font-medium text-accent-cyan">{p.highlight}</p>
                )}
                <div class="flex flex-wrap gap-1.5">
                  {p.tech.map((tech) => (
                    <span class="rounded-full bg-surface-light px-2.5 py-0.5 text-xs text-text-muted">
                      {tech}
                    </span>
                  ))}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>

    {/* Earlier Projects */}
    <div>
      <div class="mb-8">
        <h2 class="text-xl sm:text-2xl font-bold text-text-secondary mb-3">
          {t.work.earlierTitle}
        </h2>
        <p class="text-text-muted max-w-2xl">{t.work.earlierSubtitle}</p>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          t.work.earlier.map((p) => {
            const href = hrefFor(p);
            return (
              <article class="group relative rounded-lg border border-surface-border bg-surface/20 p-5 transition-colors hover:bg-surface/50">
                {href && (
                  <a
                    href={href}
                    target={isExternal(p) ? "_blank" : undefined}
                    rel={isExternal(p) ? "noopener noreferrer" : undefined}
                    class="absolute inset-0 z-10"
                    aria-label={p.title}
                  />
                )}
                {p.context && (
                  <p class="mb-2 text-[10px] font-medium uppercase tracking-wider text-text-muted">
                    {p.context}
                  </p>
                )}
                <h3 class="mb-2 text-base font-semibold text-text-primary transition-colors group-hover:text-accent-cyan">
                  {p.title}
                </h3>
                <p class="mb-3 line-clamp-2 text-xs text-text-muted">{p.description}</p>
                <div class="flex flex-wrap gap-1">
                  {p.tech.slice(0, 3).map((tech) => (
                    <span class="rounded-full bg-surface-light px-2 py-0.5 text-[10px] text-text-muted">
                      {tech}
                    </span>
                  ))}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
