---
// Tech Stack Orbital Animation Component
// Center: Rails + React (Full Stack Core).
// Inner orbit: languages & frameworks. Outer orbit: infrastructure, methodology, AI.
import {
  siReact,
  siNextdotjs,
  siNodedotjs,
  siNestjs,
  siRubyonrails,
  siGo,
  siDocker,
  siPostgresql,
  siGit,
  siClaude,
  siJira,
} from "simple-icons";
import { brandIcons } from "../config/brand-icons";

// Custom icon — Serverless Framework lightning bolt (not in simple-icons).
const serverlessIcon = {
  path: "M13.5 2L4 14h7l-2 8 11-13h-7l1-7z",
  hex: "FD5750",
};

// AWS path lives in the shared brand-icons module (simple-icons dropped AWS).
// The path is just the lowercase "a" extracted from a wider AWS wordmark, so it
// only fills ~1/3 of a 24x24 viewBox. Use a tighter custom viewBox to make it
// readable at orbit-pill size.
const awsIcon = {
  path: brandIcons.aws.path,
  hex: brandIcons.aws.hex,
  viewBox: "0 3 10 10",
};

// Override hex for icons whose brand color is pure black — invisible on dark bg.
// Keep shape compatible with simple-icons (`path` + `hex`).
const nextDotJsLight = { ...siNextdotjs, hex: "FFFFFF" };

// Inner orbit - Languages & Frameworks (Capabilities)
const innerOrbit = [
  { name: "Rails", icon: siRubyonrails },
  { name: "React", icon: siReact },
  { name: "Next.js", icon: nextDotJsLight },
  { name: "Node.js", icon: siNodedotjs },
  { name: "NestJS", icon: siNestjs },
  { name: "Go", icon: siGo },
  { name: "AWS", icon: awsIcon },
];

// Outer orbit - Infrastructure, Methodology & AI (Enablers)
const outerOrbit = [
  { name: "Docker", icon: siDocker },
  { name: "Serverless", icon: serverlessIcon },
  { name: "PostgreSQL", icon: siPostgresql },
  { name: "Git", icon: siGit },
  { name: "Agile / Jira", icon: siJira },
  { name: "Claude", icon: siClaude, isAiTool: true },
];

import { getTranslations, type Locale } from "../i18n";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const t = getTranslations(locale);
---

<section class="section-spacing overflow-hidden">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">
        {t.techStack.title}
      </h2>
      <p class="text-text-secondary max-w-2xl mx-auto text-lg">
        {t.techStack.subtitle}
      </p>
    </div>

    <div class="orbit-container" id="orbit-container">
      <!-- Center Core - Rails + React Full-Stack Foundation -->
      <div class="orbit-center">
        <div class="center-icons">
          <svg role="img" viewBox="0 0 24 24" class="center-icon" aria-label="Ruby on Rails">
            <path d={siRubyonrails.path} fill={`#${siRubyonrails.hex}`}></path>
          </svg>
          <span class="center-divider" aria-hidden="true">+</span>
          <svg role="img" viewBox="0 0 24 24" class="center-icon" aria-label="React">
            <path d={siReact.path} fill={`#${siReact.hex}`}></path>
          </svg>
        </div>
        <span class="center-label">{t.techStack.coreLabel}</span>
      </div>

      <!-- Inner Orbit - Languages & Frameworks -->
      <div class="orbit-ring orbit-inner"></div>
      <div class="orbit-items" data-orbit="inner">
        {
          innerOrbit.map((tech, i) => (
            <div
              class="orbit-item"
              data-index={i}
              data-total={innerOrbit.length}
              data-orbit-type="inner"
              style={`--color: #${tech.icon.hex};`}
            >
              <div class="tech-badge">
                <svg
                  role="img"
                  viewBox={tech.icon.viewBox ?? "0 0 24 24"}
                  class="tech-icon"
                  style={`fill: #${tech.icon.hex};`}
                >
                  <path d={tech.icon.path} />
                </svg>
                <span class="tech-name">{tech.name}</span>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Outer Orbit - Infrastructure & Tools -->
      <div class="orbit-ring orbit-outer"></div>
      <div class="orbit-items" data-orbit="outer">
        {
          outerOrbit.map((tech, i) => (
            <div
              class={`orbit-item ${tech.isAiTool ? "ai-tool" : ""}`}
              data-index={i}
              data-total={outerOrbit.length}
              data-orbit-type="outer"
              style={`--color: #${tech.icon.hex};`}
            >
              <div class="tech-badge">
                <svg
                  role="img"
                  viewBox={tech.icon.viewBox ?? "0 0 24 24"}
                  class="tech-icon"
                  style={`fill: #${tech.icon.hex};`}
                >
                  <path d={tech.icon.path} />
                </svg>
                <span class="tech-name">{tech.name}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .orbit-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 480px;
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .orbit-container {
      height: 560px;
      max-width: 800px;
    }
  }

  @media (min-width: 1024px) {
    .orbit-container {
      height: 640px;
      max-width: 900px;
    }
  }

  /* Center Core - Rails + React Full-Stack Foundation */
  .orbit-center {
    position: absolute;
    z-index: 30;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    /* Blend Rails red (#cc0000) and React cyan (#61dafb). */
    background: linear-gradient(
      135deg,
      rgba(204, 0, 0, 0.12),
      rgba(97, 218, 251, 0.12)
    );
    border: 2px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    box-shadow:
      0 0 40px rgba(34, 211, 238, 0.15),
      inset 0 0 20px rgba(204, 0, 0, 0.05);
  }

  @media (min-width: 640px) {
    .orbit-center {
      width: 150px;
      height: 150px;
    }
  }

  @media (min-width: 1024px) {
    .orbit-center {
      width: 170px;
      height: 170px;
    }
  }

  .center-icons {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .center-icon {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 0 8px color-mix(in srgb, currentColor 0%, transparent));
  }

  @media (min-width: 640px) {
    .center-icon {
      width: 34px;
      height: 34px;
    }
    .center-icons {
      gap: 8px;
    }
  }

  @media (min-width: 1024px) {
    .center-icon {
      width: 40px;
      height: 40px;
    }
    .center-icons {
      gap: 10px;
    }
  }

  .center-divider {
    font-size: 18px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1;
  }

  @media (min-width: 640px) {
    .center-divider {
      font-size: 22px;
    }
  }

  @media (min-width: 1024px) {
    .center-divider {
      font-size: 26px;
    }
  }

  .center-label {
    font-size: 10px;
    font-weight: 600;
    color: #94a3b8;
    margin-top: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    max-width: 110px;
  }

  @media (min-width: 640px) {
    .center-label {
      font-size: 11px;
      max-width: 130px;
    }
  }

  /* Orbit Rings */
  .orbit-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  .orbit-inner {
    width: 240px;
    height: 240px;
  }

  .orbit-outer {
    width: 400px;
    height: 400px;
  }

  @media (min-width: 640px) {
    .orbit-inner {
      width: 300px;
      height: 300px;
    }
    .orbit-outer {
      width: 480px;
      height: 480px;
    }
  }

  @media (min-width: 1024px) {
    .orbit-inner {
      width: 340px;
      height: 340px;
    }
    .orbit-outer {
      width: 560px;
      height: 560px;
    }
  }

  /* Orbit Items Container */
  .orbit-items {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Individual Orbit Items */
  .orbit-item {
    position: absolute;
    top: 50%;
    left: 50%;
    pointer-events: auto;
    z-index: 20;
    will-change: transform;
  }

  /* Tech Badge */
  .tech-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    white-space: nowrap;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: default;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
  }

  .tech-badge:hover {
    border-color: var(--color);
    background: rgba(15, 15, 15, 0.98);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.5),
      0 0 20px color-mix(in srgb, var(--color) 25%, transparent);
    transform: scale(1.08);
  }

  .tech-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    transition: filter 0.25s ease;
  }

  @media (min-width: 640px) {
    .tech-badge {
      padding: 10px 16px;
      gap: 10px;
    }
    .tech-icon {
      width: 20px;
      height: 20px;
    }
  }

  .tech-badge:hover .tech-icon {
    filter: drop-shadow(0 0 6px currentColor);
  }

  .tech-name {
    font-size: 12px;
    font-weight: 500;
    color: #94a3b8;
    transition: color 0.25s ease;
  }

  @media (min-width: 640px) {
    .tech-name {
      font-size: 13px;
    }
  }

  .tech-badge:hover .tech-name {
    color: #f1f5f9;
  }

  /* AI Tools styling - same size, subtle indicator */
  .ai-tool .tech-badge {
    border-style: dashed;
  }
</style>

<script>
  class OrbitAnimation {
    private container: HTMLElement | null;
    private innerItems: HTMLElement[] = [];
    private outerItems: HTMLElement[] = [];
    private innerAngle: number = 0;
    private outerAngle: number = 0;
    private animationId: number | null = null;
    private lastTime: number = 0;
    private isPaused: boolean = false;
    private isVisible: boolean = false;
    private prefersReducedMotion: boolean = false;
    private observer: IntersectionObserver | null = null;
    private motionMql: MediaQueryList | null = null;

    // Orbit configurations
    private readonly config = {
      inner: {
        speed: 0.012, // degrees per ms
        direction: 1,
        getRadius: () => {
          const width = window.innerWidth;
          if (width >= 1024) return 170;
          if (width >= 640) return 150;
          return 120;
        },
      },
      outer: {
        speed: 0.008,
        direction: -1,
        getRadius: () => {
          const width = window.innerWidth;
          if (width >= 1024) return 280;
          if (width >= 640) return 240;
          return 200;
        },
      },
    };

    constructor() {
      this.container = document.getElementById("orbit-container");
      if (!this.container) return;

      this.motionMql = window.matchMedia("(prefers-reduced-motion: reduce)");
      this.prefersReducedMotion = this.motionMql.matches;

      this.initItems();
      this.setupEventListeners();

      if (this.prefersReducedMotion) {
        // Static layout, no rAF loop.
        this.updatePositions();
      } else {
        this.setupVisibilityObserver();
        this.startAnimation();
      }
    }

    private initItems() {
      const innerContainer = document.querySelector('[data-orbit="inner"]');
      const outerContainer = document.querySelector('[data-orbit="outer"]');

      if (innerContainer) {
        this.innerItems = Array.from(
          innerContainer.querySelectorAll(".orbit-item")
        );
      }
      if (outerContainer) {
        this.outerItems = Array.from(
          outerContainer.querySelectorAll(".orbit-item")
        );
      }

      // Initial positioning
      this.updatePositions();
    }

    private setupEventListeners() {
      // Pause on hover over any item
      [...this.innerItems, ...this.outerItems].forEach((item) => {
        item.addEventListener("mouseenter", () => (this.isPaused = true));
        item.addEventListener("mouseleave", () => (this.isPaused = false));
      });

      // Handle resize
      window.addEventListener("resize", () => this.updatePositions());

      // React to reduced-motion preference changes mid-session.
      this.motionMql?.addEventListener("change", (e) => {
        this.prefersReducedMotion = e.matches;
        if (e.matches) {
          if (this.animationId) cancelAnimationFrame(this.animationId);
          this.animationId = null;
        } else if (!this.animationId) {
          this.lastTime = 0;
          this.startAnimation();
        }
      });
    }

    private setupVisibilityObserver() {
      if (!this.container || typeof IntersectionObserver === "undefined") {
        this.isVisible = true;
        return;
      }
      this.observer = new IntersectionObserver(
        (entries) => {
          this.isVisible = entries[0]?.isIntersecting ?? false;
        },
        { threshold: 0.05 }
      );
      this.observer.observe(this.container);
    }

    private updatePositions() {
      // Update inner orbit items
      this.innerItems.forEach((item, index) => {
        const total = this.innerItems.length;
        const itemAngle = (360 / total) * index + this.innerAngle;
        const radius = this.config.inner.getRadius();
        this.positionItem(item, itemAngle, radius);
      });

      // Update outer orbit items
      this.outerItems.forEach((item, index) => {
        const total = this.outerItems.length;
        const itemAngle = (360 / total) * index + this.outerAngle;
        const radius = this.config.outer.getRadius();
        this.positionItem(item, itemAngle, radius);
      });
    }

    private positionItem(item: HTMLElement, angle: number, radius: number) {
      const radians = (angle * Math.PI) / 180;
      const x = Math.cos(radians) * radius;
      const y = Math.sin(radians) * radius;
      item.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px))`;
    }

    private startAnimation() {
      const animate = (currentTime: number) => {
        const deltaTime = this.lastTime ? currentTime - this.lastTime : 0;
        this.lastTime = currentTime;

        if (!this.isPaused && this.isVisible) {
          this.innerAngle +=
            this.config.inner.speed * deltaTime * this.config.inner.direction;
          this.outerAngle +=
            this.config.outer.speed * deltaTime * this.config.outer.direction;

          this.innerAngle = this.innerAngle % 360;
          this.outerAngle = this.outerAngle % 360;

          this.updatePositions();
        } else if (!this.isVisible) {
          // Reset frame delta so re-entering the viewport doesn't fast-forward
          // by the time spent off-screen.
          this.lastTime = 0;
        }

        this.animationId = requestAnimationFrame(animate);
      };

      this.animationId = requestAnimationFrame(animate);
    }

    public destroy() {
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
      }
      this.observer?.disconnect();
    }
  }

  // Initialize
  const init = () => new OrbitAnimation();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
